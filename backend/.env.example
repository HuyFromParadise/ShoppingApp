# Copy to backend/.env and fill in local values. .env is gitignored; never commit real credentials.

# Application
# SPRING_PROFILES_ACTIVE is mapped to spring.profiles.active in application.yml
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database (local dev) - consumed by spring.datasource
DB_URL=jdbc:mysql://localhost:3306/clothing?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=clothing
DB_PASSWORD=change-me-local-only

# Test database (integration tests, spring profile "test")
TEST_DB_URL=jdbc:mysql://localhost:3306/clothing_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TEST_DB_USERNAME=clothing
TEST_DB_PASSWORD=change-me-local-only

# Security / JWT (must be >= 32 bytes)
JWT_SECRET=change-me-local-only-32-plus-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Admin bootstrap (local profile only)
SEED_ADMIN_EMAIL=admin@local.clothing
SEED_ADMIN_PASSWORD=change-me-local-only

# VNPay (not configured; mock gateway returns PROVIDER_NOT_CONFIGURED)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Image storage (local disk in MVP)
IMAGE_STORAGE_ROOT=backend/uploads

# API docs (Swagger UI: http://localhost:8080/swagger-ui.html)
# Set true locally to enable the Swagger UI and /v3/api-docs
SPRINGDOC_ENABLED=false
