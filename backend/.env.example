# Copy to backend/.env and fill in local values. .env is gitignored; never commit real credentials.

# Application
# SPRING_PROFILES_ACTIVE is mapped to spring.profiles.active in application.yml
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database (local dev) - consumed by spring.datasource
DB_URL=jdbc:mysql://localhost:3306/clothing?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=clothing
DB_PASSWORD=change-me-local-only

# Test database (integration tests, spring profile "test")
TEST_DB_URL=jdbc:mysql://localhost:3306/clothing_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TEST_DB_USERNAME=clothing
TEST_DB_PASSWORD=change-me-local-only

# Security / JWT (must be >= 32 bytes)
JWT_SECRET=change-me-local-only-32-plus-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Browser origin of the storefront. CORS allows only this origin, and the
# refresh cookie is only accepted from it. Must match the URL the frontend
# runs on (http://localhost:3000 by default).
FRONTEND_ORIGIN=http://localhost:3000

# Admin bootstrap (local profile only)
SEED_ADMIN_EMAIL=admin@local.clothing
SEED_ADMIN_PASSWORD=change-me-local-only

# VNPay (not configured: create calls return PROVIDER_NOT_CONFIGURED and every
# webhook is rejected). Leave empty until real sandbox credentials exist; no
# values are invented here. All three are required to enable the provider.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
# Storefront URL the provider redirects the browser to after payment.
VNPAY_RETURN_URL=http://localhost:3000/account/orders
# How long the VNPay payment page stays valid (provider-side expiry).
VNPAY_EXPIRE_MINUTES=15

# Orders: unpaid orders are cancelled and restocked after this window (ADR-005)
APP_ORDER_PAYMENT_WINDOW_MINUTES=30
APP_ORDER_TIMEOUT_SWEEP_MS=60000

# Base URL the API is reached at; the mock payment page link is built from it
APP_PAYMENT_PUBLIC_BASE_URL=http://localhost:8080/api/v1

# Image storage (local disk in MVP)
IMAGE_STORAGE_ROOT=backend/uploads

# API docs (Swagger UI: http://localhost:8080/swagger-ui.html)
# Set true locally to enable the Swagger UI and /v3/api-docs
SPRINGDOC_ENABLED=false
